#!/bin/sh
# Runs the copy of agent-friction that ships inside this Claude Code plugin, with
# the first Python 3.10+ on PATH. Nothing gets installed: the package uses only
# the standard library, so its source directory is enough.
#
# The skills run this from the repository being scanned. `python -m` would put
# that directory first on sys.path, so a json.py there would be imported; the
# bootstrap below puts the bundled source in its place instead.
src=$(CDPATH='' cd -- "$(dirname -- "$0")/../src" && pwd) || exit 1
case "$(uname -s 2>/dev/null)" in
  MINGW* | MSYS*) src=$(CDPATH='' cd -- "$src" && pwd -W) || exit 1 ;; # C:/... for Windows Python
esac
run='import sys; sys.path[0] = sys.argv.pop(1); import runpy; runpy.run_module("agent_friction", run_name="__main__", alter_sys=True)'
check='import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "$check" >/dev/null 2>&1; then
    exec "$py" -c "$run" "$src" "$@"
  fi
done
if command -v py >/dev/null 2>&1 && py -3 -c "$check" >/dev/null 2>&1; then
  exec py -3 -c "$run" "$src" "$@"
fi
echo "agent-friction: needs Python 3.10 or newer on PATH (python3, python or py)." >&2
exit 127
